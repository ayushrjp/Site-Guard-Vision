# ---------------------------------------------------------------------------
# SiteGuardVision environment template.
# These are shell / Render environment variables read by the application at
# startup. The project does NOT load .env automatically - use this file as a
# reference and export the variables in your shell, or copy the values into
# the Render Dashboard. Never commit a real .env.
# All values below are placeholders.
# ---------------------------------------------------------------------------

# --- Safety Assistant (Ollama) -------------------------------------------
# Local default. On Render point this at a reachable, authenticated Ollama
# service - never expose an unsecured Ollama port to the public internet.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_STATUS_TIMEOUT=2.5

# --- Writable storage -----------------------------------------------------
# Local default: <project>/data. On Render: /var/data (persistent disk).
# SITEGUARD_DATA_DIR=/var/data
# Individual overrides (optional; defaults derive from SITEGUARD_DATA_DIR):
# SITEGUARD_DB_PATH=/var/data/siteguard.db
# SITEGUARD_IMAGE_UPLOAD_DIR=/var/data/image_uploads
# SITEGUARD_RENDERED_DIR=/var/data/rendered
# SITEGUARD_VIDEO_UPLOAD_DIR=/var/data/video_uploads
# SITEGUARD_VIDEO_OUTPUT_DIR=/var/data/video_outputs
# SITEGUARD_VIDEO_THUMB_DIR=/var/data/video_thumbnails

# --- RAG / knowledge base -------------------------------------------------
# SITEGUARD_VECTOR_DB=/var/data/vector_db
# SITEGUARD_KNOWLEDGE_BASE=/var/data/knowledge_base
# SITEGUARD_COLLECTION=safety_documents
# SITEGUARD_TOP_K=5
# SITEGUARD_MIN_SIMILARITY=0.18

# --- Bundled sample videos (read-only) ------------------------------------
# SITEGUARD_SAMPLE_VIDEO_DIR=test_videos

# --- Runtime / deployment -------------------------------------------------
# 1 = trust one X-Forwarded-* proxy hop (required on Render).
SITEGUARD_BEHIND_PROXY=0
SITEGUARD_LOG_LEVEL=INFO
# FLASK_DEBUG=1 enables the interactive debugger for local work only.
FLASK_DEBUG=0
# HOST=127.0.0.1
# PORT=5000
